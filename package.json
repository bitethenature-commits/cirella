{
  "name": "cirella",
  "version": "0.1.0",
  "private": true,
  "description": "Cirella — convierte tu perfil social en tu negocio completo, desde un solo enlace.",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/assert-local-db.ts && prisma migrate deploy && tsx prisma/seed.ts",
    "setup": "tsx scripts/assert-local-db.ts && prisma migrate deploy && tsx prisma/seed.ts",
    "deploy": "tsx scripts/check-env.ts && prisma migrate deploy && tsx prisma/bootstrap.ts",
    "check:env": "tsx scripts/check-env.ts",
    "admin:promote": "tsx scripts/make-admin.ts",
    "personal:setup": "tsx scripts/personal-setup.ts",
    "media:probe": "tsx scripts/probe-media.ts",
    "test:unit": "tsx scripts/unit-tests.ts",
    "test:isolation": "tsx --conditions=react-server scripts/tenant-isolation-test.ts && tsx scripts/storage-isolation-test.ts",
    "test:concurrency": "tsx --conditions=react-server scripts/booking-concurrency-test.ts",
    "test:reliability": "tsx --conditions=react-server scripts/reliability-test.ts",
    "test:payments": "tsx --conditions=react-server scripts/payments-test.ts",
    "test:refunds": "tsx --conditions=react-server scripts/refunds-test.ts",
    "test:access": "tsx --conditions=react-server scripts/access-test.ts",
    "test:legal": "tsx --conditions=react-server scripts/legal-test.ts",
    "test:invoices": "DEMO_MODE=false tsx --conditions=react-server scripts/invoices-test.ts",
    "test:delivery": "tsx --conditions=react-server scripts/delivery-test.ts",
    "test:limits": "TURNSTILE_SITE_KEY=1x00000000000000000000AA TURNSTILE_SECRET_KEY=prueba-limites tsx --conditions=react-server scripts/rate-limit-test.ts",
    "test:seed-guard": "tsx scripts/seed-guard-test.ts",
    "test:startup": "tsx scripts/startup-guard-test.ts",
    "test:optout": "tsx --conditions=react-server scripts/optout-test.ts",
    "test:free-access": "tsx --conditions=react-server scripts/free-access-test.ts",
    "test:personal-sales": "tsx --conditions=react-server scripts/personal-sales-test.ts",
    "test:revision": "for f in scripts/revision-*-test.ts; do echo \"── $f\"; tsx --conditions=react-server \"$f\" || exit 1; done",
    "test:rich-text": "tsx --conditions=react-server scripts/rich-text-test.ts",
    "test:media": "tsx --conditions=react-server scripts/media-test.ts",
    "test:lessons": "tsx --conditions=react-server scripts/lessons-test.ts",
    "test:calendar": "tsx --conditions=react-server scripts/calendar-test.ts",
    "test:e2e": "playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "@aws-sdk/s3-request-presigner": "3.1139.0",
    "@next/env": "15.5.27",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "10.75.2",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.53.0",
    "next": "^15.5.27",
    "pdfjs-dist": "6.3.289",
    "react": "19.2",
    "react-dom": "19.2",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "stripe": "22.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "engines": {
    "node": ">=22.13"
  }
}
