{
  "name": "cirella",
  "version": "0.1.0",
  "private": true,
  "description": "Cirella — convierte tu perfil social en tu negocio completo, desde un solo enlace.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
