# Base de datos (SQLite en desarrollo; para producción cambia provider a "postgresql" en prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# URL pública de la plataforma (se usa en enlaces, emails y SEO)
APP_URL="http://localhost:3000"

# Modo demo: muestra accesos rápidos, buzón de emails de prueba (/dev/correo) y pagos simulados
DEMO_MODE="true"

# Carpeta donde se guardan los archivos subidos (públicos y privados)
STORAGE_DIR="./storage"

# Secreto para el endpoint de tareas programadas (/api/cron)
CRON_SECRET="cambia-esto"

# Pasarela de pago: "simulated" (MVP) | "stripe" (pendiente de integrar)
PAYMENT_PROVIDER="simulated"
