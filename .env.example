# Configuración de Cirella. Estos valores funcionan tal cual en local (cp .env.example .env).
# Al arrancar, la app valida todo (lib/env.ts) y no arranca si algo no encaja con APP_ENV.
# En producción las variables se definen en el hosting, nunca en un archivo del repositorio:
# ver la tabla «Configuración» del README. Comprobación previa: npm run check:env

# ── Entorno ──
# development | test | staging | production. Sin APP_ENV, `next start` cuenta como production.
# Fuera de producción APP_URL tiene que ser local (localhost o red privada).
APP_ENV="development"
# Dirección pública (enlaces de los emails, SEO). En producción: https://tu-dominio, sin ruta.
APP_URL="http://localhost:3000"

# ── Base de datos PostgreSQL ──
# En local: `docker compose up -d db` levanta Postgres 16 con estos datos.
# DATABASE_URL es la conexión de la aplicación (en producción, la del pooler) y DIRECT_URL la
# conexión directa que usan las migraciones. En local son la misma.
DATABASE_URL="postgresql://cirella:cirella@localhost:5432/cirella"
DIRECT_URL="postgresql://cirella:cirella@localhost:5432/cirella"
# Solo para `npm run db:check`: una BD vacía de usar y tirar (Prisma la borra y recrea). npm no lee
# este archivo, así que se pasa al ejecutar el comando (ver README):
#   SHADOW_DATABASE_URL="postgresql://cirella:cirella@localhost:5432/cirella_shadow" npm run db:check

# ── Modo del sitio ──
# "platform" (por defecto): Cirella para muchas creadoras. "personal": la web de una sola dueña
# (su página es la portada, sin registro de otras creadoras ni cobros en la web).
# SITE_MODE="platform"
#
# Modo personal (descomenta este bloque; en producción, defínelo en el hosting):
# SITE_MODE="personal"
# OWNER_USERNAME="ana"          # obligatorio: el usuario de tu página (con los datos de la demo, ana)
# PAYMENT_PROVIDER="none"       # sin pagos online: lo de pago se cobra fuera (Hotmart, PayPal, Calendly…)
#                               # Con "none" no hacen falta las claves de Stripe ni de Turnstile. El resto
#                               # (APP_URL https, secretos, Resend, R2, CLIENT_IP_HEADER) se exige igual.

# ── Modo demo ──
# Accesos rápidos en /entrar y buzón /dev/correo (solo para la administradora).
# Prohibido en staging y production: la app no arranca.
DEMO_MODE="true"

# ── Pagos ── (obligatorio en todos los entornos, sin valor por defecto)
# "simulated" solo en local y pruebas; "stripe" en staging y production; "none" (sin cobros en la web)
# en local o, en staging y production, solo en modo personal.
PAYMENT_PROVIDER="simulated"
# Claves de prueba (sk_test_/pk_test_) fuera de producción; live (sk_live_/pk_live_) en producción.
# STRIPE_SECRET_KEY="sk_test_…"
# STRIPE_PUBLISHABLE_KEY="pk_test_…"
# STRIPE_WEBHOOK_SECRET="whsec_…"          # endpoint de plataforma de /api/webhooks/stripe
# STRIPE_CONNECT_WEBHOOK_SECRET="whsec_…"  # endpoint de «eventos en cuentas conectadas» (account.updated)
# STRIPE_ON_BEHALF_OF="false"              # "true": la creadora es la comerciante de liquidación (ver docs/pagos-stripe.md)

# ── Secretos ── (producción: 32+ caracteres aleatorios, genera cada uno con `openssl rand -hex 32`)
# Bearer token de /api/cron (programarlo cada 5 min). Este valor de ejemplo no se acepta en producción.
CRON_SECRET="local-cron-secret-no-usar-en-produccion-000"
# Clave para firmar enlaces, billetes de subida y URLs temporales de descarga. Fuera de producción hay una fija de desarrollo.
# APP_SECRET="…"

# ── Email ── "log" (local: se guardan y se ven en /dev/correo) | "resend" (producción)
# Con "log", las direcciones con +fallo (fallo temporal) o +rebote (rechazada) simulan errores del
# proveedor para probar los reintentos (1 min, 5 min, 30 min, 2 h y 12 h).
EMAIL_PROVIDER="log"
# RESEND_API_KEY="re_…"
# Remitente en un dominio verificado en Resend. Los emails a clientas usan el nombre de la creadora
# con esta misma dirección y responden a su email de contacto.
# EMAIL_FROM="Cirella <hola@cirella.app>"

# ── Archivos ── "local" (carpeta STORAGE_DIR) | "s3" (Cloudflare R2 en producción)
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
# Cloudflare R2 (producción): ver docs/despliegue.md
# S3_ENDPOINT="https://<cuenta>.eu.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="cirella"
# S3_ACCESS_KEY_ID="…"
# S3_SECRET_ACCESS_KEY="…"
# S3_PUBLIC_URL no hace falta: los buckets son privados y todo se sirve con URLs firmadas.

# ── Opcionales ──
# Sentry (errores, alertas y monitor del cron). Crea la organización en la región UE: el DSN usa
# ingest.de.sentry.io. Sin DSN no se carga y los errores quedan en el log del servidor.
# SENTRY_DSN="https://…@….ingest.de.sentry.io/…"
# Turnstile (captcha invisible en el checkout tras varios pagos rechazados): las dos claves o ninguna.
# TURNSTILE_SITE_KEY="…"
# TURNSTILE_SECRET_KEY="…"
# Cabecera con la IP real de la clienta que la plataforma sobrescribe siempre (límites de intentos).
# Obligatoria en producción: x-real-ip en Vercel (sin Cloudflare como proxy delante: Vercel deja
# pasar cf-connecting-ip y cualquiera podría inventársela). Sin ella, el último valor de X-Forwarded-For.
# CLIENT_IP_HEADER="x-real-ip"
